<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>BlackMarket</string>
    <key>CFBundleIdentifier</key>
    <string>com.worksin.one</string>
    <key>CFBundleName</key>
    <string>Black Market</string>
    <key>CFBundleDisplayName</key>
    <string>Black Market</string>
    <key>CFBundleVersion</key>
    <string>1.0.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>

    <!-- 지원 언어 목록 명시 -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>ko</string>
        <string>en</string>
        <string>ja</string>
        <string>zh-Hans</string>
        <string>ru</string>
        <string>fr</string>
    </array>

    <!-- 백그라운드 푸시 알림 모드 -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>

    <!-- 앱 아이콘 설정 -->
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon60x60</string>
            </array>
            <key>CFBundleIconName</key>
            <string>AppIcon</string>
        </dict>
    </dict>

    <!-- 커스텀 URL 스키마 (blackmarket://) -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>com.worksin.one</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>blackmarket</string>
            </array>
        </dict>
    </array>

    <!-- 기본 권한 문구 (다국어 파일이 없을 때 Fallback으로 사용) -->
    <key>NSFaceIDUsageDescription</key>
    <string>Biometric authentication is required for passkey login and identity verification.</string>
    <key>NSPhotoLibraryAdditionsUsageDescription</key>
    <string>Permission is required to save photos and videos from the mailbox to your photo library.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Permission is required to save media from the mailbox to your photo library.</string>

    <!-- 외부 미디어 및 CDN 로드 허용 -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
